# greenroom 模型配置 —— 复制成 .env、填入你自己的 key（BYOK，自带钥匙）。
# 不填也能用：控制台阅读、155 岗百科照常；填了才解锁「实时助手」与「模拟面试」。
# start.sh 首次运行会自动把本文件复制成 .env。

# 任意 OpenAI 兼容服务的 key（兼容旧名 DEEPSEEK_API_KEY / OPENAI_API_KEY）
MODEL_API_KEY=sk-your-own-key-here

# 可选：模型服务地址（默认 DeepSeek；可换 OpenAI / Ollama 等任意 OpenAI 兼容接口）
# MODEL_API_BASE=https://api.deepseek.com

# 可选：模型名
# MODEL_NAME=deepseek-v4-flash

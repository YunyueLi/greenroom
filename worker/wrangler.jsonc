{
  // greenroom Worker backend — stateless backend for hosted/self-hosted web apps.
  // Deploy: cd worker && npx wrangler deploy
  // Then set the model key as a SECRET (never put it in vars):
  //   npx wrangler secret put MODEL_API_KEY
  "name": "greenroom-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-06-20",
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["23 */6 * * *"]
  },
  // Public, non-secret config. The model key is a secret (wrangler secret put MODEL_API_KEY).
  // Any OpenAI-compatible endpoint works — point MODEL_API_BASE / MODEL_NAME wherever you like.
  "vars": {
    "MODEL_API_BASE": "https://api.deepseek.com",
    "MODEL_NAME": "deepseek-v4-flash",
    "MODEL_NAME_PRO": "deepseek-v4-pro",
    // Free allowance per signed-in ACCOUNT — lifetime total, NOT per day (the gate sums
    // all-time calls). Tune freely. Generation/mock run on the pro model — keep them small.
    "FREE_ANSWER": "30",
    "FREE_SETUP": "2",
    "FREE_MOCK": "10",
    // Pass tier (paid season pass) — effectively unlimited.
    "PASS_ANSWER": "3000",
    "PASS_SETUP": "50",
    "PASS_MOCK": "600"
  },
  // Optional metering store (Cloudflare D1). Gating activates only when SUPABASE_URL
  // is also set as a Worker secret. Create your own database and replace the id.
  "d1_databases": [
    { "binding": "DB", "database_name": "greenroom-meter", "database_id": "replace-with-your-d1-database-id" }
  ],
  // Optional: add your own custom domain route here, or use the *.workers.dev URL.
  // "routes": [
  //   { "pattern": "greenroom-api.example.com", "custom_domain": true }
  // ]
}
